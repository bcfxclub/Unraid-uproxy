<?xml version="1.0" encoding="UTF-8"?>
<Container version="2">
  <Name>uproxy</Name>
  <!-- 存储库：完整镜像地址。默认指向 Docker Hub 公开镜像 bcfx/uproxy:latest
       （随 GitHub tag 自动构建、匿名可拉，无需令牌，Unraid「强制更新」即可拉到新版本）。
       备选：GHCR 镜像 ghcr.io/bcfxclub/uproxy:latest（同样自动构建，但 GHCR 包默认私有，
       需先在 GitHub 仓库 Settings → Packages 把 bcfxclub/uproxy 设为 Public，否则拉取要令牌）。
       注意：GHCR 包名必须全小写，仓库名 Unraid-uproxy 大写不被 GHCR 接受，故 GHCR 镜像名固定为 uproxy。 -->
  <Repository>bcfx/uproxy:latest</Repository>
  <Registry></Registry>
  <Network>bridge</Network>
  <Restart>unless-stopped</Restart>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support/>
  <Overview>Unraid 出网加速编排工具。sing-box / WARP 在本容器内作为进程直接运行，监听代理端口（7890=sing-box，9091=WARP），
并把端口发布到宿主。Unraid 7.0+ 推荐：设置 → 出站代理管理器，把代理地址填成 http://[IP]:7890（或 9091）即可让系统出网走代理；
6.x 系统可继续用本工具的「下发」把代理写入 dockerd / CA 商店 / wgetrc。自带备份、开机重放与一键还原。</Overview>
  <Category>Tools:</Category>
  <WebUI>http://[IP]:[PORT:8765]/</WebUI>
  <TemplateURL/>
  <Icon/>
  <ExtraParams>--cap-add NET_ADMIN --device /dev/net/tun</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="WebUI 端口" Target="8765" Default="8765" Mode="tcp" Description="Web 管理界面端口" Type="Port" Display="always" Required="true" Mask="false">8765:8765</Config>
  <Config Name="sing-box 代理端口" Target="7890" Default="7890" Mode="tcp" Description="订阅节点出口的 HTTP/SOCKS 代理端口（Unraid 7.0+ 出站代理管理器指向这里）" Type="Port" Display="always" Required="false" Mask="false">7890:7890</Config>
  <Config Name="WARP 代理端口" Target="9091" Default="9091" Mode="tcp" Description="WARP 出口的 HTTP/SOCKS 代理端口" Type="Port" Display="always" Required="false" Mask="false">9091:9091</Config>
  <Config Name="U盘配置 /boot" Target="/host/boot" Default="/boot" Mode="rw" Description="读写 U 盘配置：开机脚本 go 与 CA 商店 proxy.cfg" Type="Path" Display="always" Required="true" Mask="false">/boot</Config>
  <Config Name="Docker 配置目录" Target="/host/etc/docker" Default="/etc/docker" Mode="rw" Description="读写 daemon.json（registry-mirrors）" Type="Path" Display="always" Required="true" Mask="false">/etc/docker</Config>
  <Config Name="Docker 启动脚本目录" Target="/host/usr/local/etc/rc.d" Default="/usr/local/etc/rc.d" Mode="rw" Description="读写 rc.docker（dockerd 代理注入点）" Type="Path" Display="always" Required="true" Mask="false">/usr/local/etc/rc.d</Config>
  <Config Name="系统 profile 目录" Target="/host/etc/profile.d" Default="/etc/profile.d" Mode="rw" Description="读写系统代理环境变量" Type="Path" Display="always" Required="true" Mask="false">/etc/profile.d</Config>
  <Config Name="系统 /etc 目录" Target="/host/etc" Default="/etc" Mode="rw" Description="写 /etc/wgetrc：让 Unraid 装插件/下载 txz 也走代理（CA 商店的 proxy.cfg 管不到插件安装）" Type="Path" Display="always" Required="false" Mask="false">/etc</Config>
  <Config Name="工具状态与备份" Target="/config" Default="/mnt/user/appdata/uproxy/state" Mode="rw" Description="配置、sing-box 配置与自动备份（务必放在阵列/缓存上以持久保存）" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/uproxy/state</Config>
  <Config Name="Docker 套接字" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="rw" Description="仅 Unraid 6.x 重启 dockerd 时需要（让 daemon.json 生效）；sing-box / WARP 已改进程内运行，不再依赖它" Type="Device" Display="always" Required="true" Mask="false">/var/run/docker.sock</Config>
  <Config Name="访问口令" Target="UPX_TOKEN" Default="" Mode="" Description="强烈建议设置：同网段任何人都能改你的 Docker 配置。留空表示不校验" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="宿主机根挂载点" Target="UPX_HOST_ROOT" Default="/host" Mode="" Description="容器内宿主机根目录前缀，一般不用改" Type="Variable" Display="advanced" Required="true" Mask="false">/host</Config>
  <Config Name="时区" Target="TZ" Default="Asia/Shanghai" Mode="" Description="" Type="Variable" Display="advanced" Required="false" Mask="false">Asia/Shanghai</Config>
  <Config Name="状态目录" Target="UPX_STATE_DIR" Default="/config" Mode="" Description="容器内配置与备份目录，对应挂载的 /config 卷" Type="Variable" Display="advanced" Required="true" Mask="false">/config</Config>
  <Config Name="登录用户名" Target="UPX_USER" Default="admin" Mode="" Description="WebUI 登录用户名" Type="Variable" Display="advanced" Required="false" Mask="false">admin</Config>
</Container>
